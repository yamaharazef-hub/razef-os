#  ██╔══██╗██╔══██╗╚══███╔╝██╔════╝██╔════╝    ██╔═══██╗██╔════╝
#  ██████╔╝███████║  ███╔╝ █████╗  █████╗      ██║   ██║███████╗
#  ██╔══██╗██╔══██║ ███╔╝  ██╔══╝  ██╔══╝      ██║   ██║╚════██║
#  ██║  ██║██║  ██║███████╗███████╗██║         ╚██████╔╝███████║
#  ╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝╚══════╝╚═╝          ╚═════╝ ╚══════╝
#
#  Razef OS - a custom, branded Bazzite (Fedora Atomic / bootc) image.
#
#  This is a *derived* image. It does not rebuild Bazzite; it takes the
#  published Bazzite image and layers on:
#     * Razef branding (os-release, boot splash, wallpapers, icons)
#     * razef-firstboot   - the post-install setup wizard
#     * razef-assist      - a local, offline AI assistant (Ollama + WebKit UI)
#
#  Build:  podman build -t razef-os:stable .
#  CI:     .github/workflows/build.yml  (auto builds on push to main)

# ---------------------------------------------------------------------------
# Stage 0: build context that is NOT copied into the final image
# ---------------------------------------------------------------------------
FROM scratch AS ctx
COPY build_files /build_files
COPY branding/assets /branding
COPY system_files /system_files

# ---------------------------------------------------------------------------
# The base image. Override with --build-arg for other hardware targets:
#   ghcr.io/ublue-os/bazzite-gnome:stable              <- default (AMD/Intel)
#   ghcr.io/ublue-os/bazzite-gnome-nvidia-open:stable   <- NVIDIA (open driver)
# ---------------------------------------------------------------------------
ARG BASE_IMAGE="ghcr.io/ublue-os/bazzite-gnome:stable"
FROM ${BASE_IMAGE}

ARG IMAGE_NAME="razef-os"
ARG IMAGE_VENDOR="razef"
ARG VERSION="1.0"
ARG OLLAMA_VERSION="latest"
ARG WITH_DEV_TOOLS="0"

LABEL org.opencontainers.image.title="${IMAGE_NAME}" \
      org.opencontainers.image.vendor="${IMAGE_VENDOR}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.description="Razef OS - Bazzite-based gaming desktop with a local AI assistant" \
      org.opencontainers.image.base.name="ghcr.io/ublue-os/bazzite-gnome:stable" \
      org.razef.os.brand="razef"

# ---------------------------------------------------------------------------
# Everything happens in build_files/build.sh so it is easy to read & lint
# ---------------------------------------------------------------------------
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    OLLAMA_VERSION="${OLLAMA_VERSION}" \
    WITH_DEV_TOOLS="${WITH_DEV_TOOLS}" \
    VERSION="${VERSION}" \
    /ctx/build_files/build.sh

# Fail the build if the result is not a valid bootc image
RUN bootc container lint
