# Razef OS - desktop defaults. These are *defaults*: users can override them.
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/razef/default.png'
picture-uri-dark='file:///usr/share/backgrounds/razef/default.png'
picture-options='zoom'
primary-color='#05070d'
secondary-color='#05070d'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
font-antialiasing='rgba'
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true
enable-hot-corners=false

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/mutter]
dynamic-workspaces=true
edge-tiling=true

[org/gnome/shell]
favorite-apps=['org.razef.Assistant.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'com.valvesoftware.Steam.desktop', 'org.mozilla.firefox.desktop']
always-show-log-out=true

# login screen logo (gnome-shell-extension-background-logo, shipped by Bazzite)
[org/gnome/shell/extensions/background-logo]
logo-file='/usr/share/pixmaps/razef-os.png'
logo-always-visible=true
