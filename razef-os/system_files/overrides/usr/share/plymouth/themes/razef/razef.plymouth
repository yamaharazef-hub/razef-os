[Plymouth Theme]
Name=Razef
Description=Razef OS boot splash
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/razef
UseFirmwareBackground=false
DialogClearsFirmwareBackground=true
BackgroundStartColor=0x05070d
BackgroundEndColor=0x0b1020
BackgroundHorizontalAlignment=.5
BackgroundVerticalAlignment=.5
HorizontalAlignment=.5
VerticalAlignment=.42
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.5
Title=Razef
SubTitle=Starting up
TitleFont=Noto Sans 22
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.76
MessageBelowAnimation=true
SuppressMessages=true
Transition=fade
TransitionDuration=0.3
UseAnimation=true
UseEndAnimation=false
ProgressBarBackgroundColor=0x111827
ProgressBarForegroundColor=0x22d3ee
ProgressBarHeight=4
ProgressBarWidth=340
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.87
ProgressBarShowPercentComplete=false
